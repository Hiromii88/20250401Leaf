= content_for 'content-header' do
  | サイトの設定

- breadcrumb :edit_admin_site

.box.box-primary
  = simple_form_for [:admin, @site], url: admin_site_path do |f|
    .box-body
      = f.error_notification
      = f.input :name
      = f.input :subtitle
      = f.input :description, as: :text
      = f.input :favicon, as: :file, hint: 'PNG (32x32)'

      - if @site.favicon.attached?
        = image_tag @site.favicon_url('32x32')
        br
        = link_to '削除', remove_image_admin_site_path(image_type: 'favicon'), method: :delete, class: %w[btn btn-sm btn-danger]
        br
        br

      = f.input :og_image, as: :file, hint: 'JPEG/PNG (1200x630)'

      - if @site.og_image.attached?
        = image_tag @site.og_image_url(:ogp), method: :delete, class: 'img-responsive'
        br
        = link_to '削除', remove_image_admin_site_path(image_type: 'og_image'), method: :delete, class: %w[btn btn-sm btn-danger]
        br
        br

      = f.input :main_images, as: :file, hint: 'JPEG/PNG (1200x400)', input_html: { multiple: true }

      - if @site.main_images.attached?
        - @site.main_images.each do |image|
          .image-container style="display: inline-block; margin-right: 10px;"
            = image_tag image.variant(resize: '100x100').processed
            br
            = link_to '削除', remove_image_admin_site_path(image_type: 'main_images', image_id: image.id), method: :delete, class: %w[btn btn-sm btn-danger], data: { turbo: false }
            br
            br

    .box-footer
      = f.button :submit, '保存', class: %w[btn btn-primary]
